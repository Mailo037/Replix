{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Replix",
  "version": "0.1.8",
  "identifier": "app.replix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Replix",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCQTI2NkMzNDdDN0VDNzgKUldSNDdNZEh3MmFpcTRidC85b1hGeXBBbWxqUWpzM3lpQVByRk5Dd20yamppeGhMQXdld2xJYW0K",
      "endpoints": [
        "https://github.com/Mailo037/Replix/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
